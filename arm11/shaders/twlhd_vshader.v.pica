; SPDX-License-Identifier: Apache-2.0
;
; TWL-HD Phase 4B - minimal debug vertex shader.
;
; Inputs:  v0 = object-space position (vec3), v1 = RGBA color (vec4).
; Uniforms: projection, modelview (both mat4).
; There is no fixed-function transform on PICA200; this is the whole pipeline.
;
; HARDWARE UNVERIFIED: compiled by picasso at build time, never executed in
; the development sandbox. API conventions follow the official devkitPro
; examples/3ds/graphics/gpu example shaders.

.fvec projection[4], modelview[4]

.constf constants(0.0, 1.0, -1.0, 0.1)
.alias  ones constants.yyyy

.out outpos position
.out outclr color

.alias inpos v0
.alias inclr v1

.proc main
	; World-space position with w = 1.0
	mov r0.xyz, inpos
	mov r0.w,   ones

	; r1 = modelview * position
	dp4 r1.x, modelview[0], r0
	dp4 r1.y, modelview[1], r0
	dp4 r1.z, modelview[2], r0
	dp4 r1.w, modelview[3], r0

	; outpos = projection * r1
	dp4 outpos.x, projection[0], r1
	dp4 outpos.y, projection[1], r1
	dp4 outpos.z, projection[2], r1
	dp4 outpos.w, projection[3], r1

	; outclr = per-vertex color
	mov outclr, inclr

	end
.end
